{
	"name": "sentinel",
	"private": true,
	"packageManager": "pnpm@10.11.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"infra:up": "docker compose up -d",
		"infra:down": "docker compose down",
		"db:generate": "pnpm --filter @sentinel/db db:generate",
		"db:migrate": "pnpm --filter @sentinel/db db:migrate",
		"db:studio": "pnpm --filter @sentinel/db db:studio",
		"test:e2e": "pnpm build && pnpm --filter @sentinel/e2e e2e",
		"seed:demo": "node examples/seed/seed.mjs",
		"demo:sourcemaps": "pnpm --filter @sentinel/cli build && node examples/sourcemaps-demo/run.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"turbo": "^2.11.7",
		"typescript": "^5.9.3"
	}
}
