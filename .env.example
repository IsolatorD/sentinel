# Entorno: development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Índice de la base de Redis (0 a 15).
REDIS_DB=0
# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Better Auth. Obligatorio, mínimo 16 caracteres.
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (opcional): crear credenciales en Google Cloud Console.
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ingesta
# Eventos por minuto permitidos por proyecto (rate limit).
INGEST_RATE_LIMIT_PER_MINUTE=600
# Poner en true si la API está detrás de un proxy/CDN (para leer la IP real).
TRUST_PROXY=false
# URL pública de la API (aparece en la DSN). Por defecto BETTER_AUTH_URL.
# PUBLIC_API_URL=http://localhost:3000

# Documentación OpenAPI en /api/docs. Por defecto activa, salvo en producción.
# ENABLE_DOCS=true
