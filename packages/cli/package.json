{
	"name": "@argus-isolator/cli",
	"version": "0.2.0",
	"description": "Sentinel CLI: upload source maps from your CI so errors show your original code.",
	"license": "MIT",
	"keywords": [
		"sourcemaps",
		"cli",
		"error-tracking"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IsolatorD/sentinel.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/IsolatorD/sentinel#readme",
	"bugs": {
		"url": "https://github.com/IsolatorD/sentinel/issues"
	},
	"type": "module",
	"bin": {
		"sentinel-cli": "./dist/bin.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sentinel/shared": "workspace:*",
		"@types/node": "^26.6.4",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
