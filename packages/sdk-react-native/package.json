{
	"name": "@sentinel/react-native",
	"version": "0.1.0",
	"description": "Sentinel SDK for React Native: captures JS errors, measures app start, navigation and requests.",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-native": ">=0.72"
	},
	"peerDependenciesMeta": {
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sentinel/core": "workspace:*",
		"@sentinel/shared": "workspace:*",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	}
}
