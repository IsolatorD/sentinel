{
	"name": "@sentinel/db",
	"version": "0.0.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"drizzle"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11"
	}
}
