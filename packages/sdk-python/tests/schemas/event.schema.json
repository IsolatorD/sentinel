{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"event_id": {
			"type": "string",
			"pattern": "^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$"
		},
		"timestamp": {
			"type": ["string", "number"]
		},
		"level": {
			"default": "error",
			"type": "string",
			"enum": ["fatal", "error", "warning", "info", "debug"]
		},
		"platform": {
			"type": "string",
			"maxLength": 256
		},
		"release": {
			"type": "string",
			"maxLength": 256
		},
		"environment": {
			"type": "string",
			"maxLength": 256
		},
		"message": {
			"type": "string",
			"maxLength": 16384
		},
		"exception": {
			"type": "object",
			"properties": {
				"values": {
					"minItems": 1,
					"maxItems": 10,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"maxLength": 256
							},
							"value": {
								"type": "string",
								"maxLength": 16384
							},
							"stacktrace": {
								"type": "object",
								"properties": {
									"frames": {
										"maxItems": 250,
										"type": "array",
										"items": {
											"type": "object",
											"properties": {
												"filename": {
													"type": "string",
													"maxLength": 2048
												},
												"function": {
													"type": "string",
													"maxLength": 256
												},
												"module": {
													"type": "string",
													"maxLength": 256
												},
												"lineno": {
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												},
												"colno": {
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												},
												"in_app": {
													"type": "boolean"
												},
												"abs_path": {
													"type": "string",
													"maxLength": 2048
												},
												"context_line": {
													"type": "string",
													"maxLength": 2048
												},
												"pre_context": {
													"maxItems": 10,
													"type": "array",
													"items": {
														"type": "string",
														"maxLength": 2048
													}
												},
												"post_context": {
													"maxItems": 10,
													"type": "array",
													"items": {
														"type": "string",
														"maxLength": 2048
													}
												},
												"symbolicated": {
													"type": "boolean"
												}
											}
										}
									}
								},
								"required": ["frames"]
							}
						},
						"required": ["type"]
					}
				}
			},
			"required": ["values"]
		},
		"fingerprint": {
			"minItems": 1,
			"maxItems": 10,
			"type": "array",
			"items": {
				"type": "string",
				"maxLength": 256
			}
		},
		"user": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"maxLength": 256
				},
				"email": {
					"type": "string",
					"maxLength": 256
				},
				"username": {
					"type": "string",
					"maxLength": 256
				},
				"ip_address": {
					"type": "string",
					"maxLength": 256
				}
			}
		},
		"tags": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"maxLength": 64
			},
			"additionalProperties": {
				"type": "string",
				"maxLength": 512
			}
		},
		"request": {
			"type": "object",
			"properties": {
				"url": {
					"type": "string",
					"maxLength": 2048
				},
				"method": {
					"type": "string",
					"maxLength": 16
				},
				"headers": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string",
						"maxLength": 1024
					}
				}
			}
		},
		"contexts": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"propertyNames": {
					"type": "string"
				},
				"additionalProperties": {}
			}
		},
		"breadcrumbs": {
			"maxItems": 100,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"timestamp": {
						"type": ["string", "number"]
					},
					"category": {
						"type": "string",
						"maxLength": 256
					},
					"type": {
						"type": "string",
						"maxLength": 256
					},
					"level": {
						"type": "string",
						"enum": ["fatal", "error", "warning", "info", "debug"]
					},
					"message": {
						"type": "string",
						"maxLength": 2048
					},
					"data": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					}
				}
			}
		},
		"extra": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {}
		}
	}
}
