{
	"name": "@sentinel/core",
	"version": "0.2.0",
	"license": "MIT",
	"description": "Sentinel SDK core: the platform-independent client, transport and tracing shared by the browser and Node SDKs.",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sentinel/shared": "workspace:*",
		"jsdom": "^30.1.2",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.5",
		"tsup": "^8.5.1"
	},
	"module": "./dist/index.js",
	"files": [
		"dist"
	]
}
