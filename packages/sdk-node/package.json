{
	"name": "@argus-isolator/node",
	"version": "0.2.0",
	"description": "Sentinel SDK for Node.js: uncaught errors, HTTP server and client tracing (Express, Fastify) and trace continuation.",
	"license": "MIT",
	"keywords": [
		"error-tracking",
		"node",
		"tracing",
		"express",
		"fastify"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IsolatorD/sentinel.git",
		"directory": "packages/sdk-node"
	},
	"homepage": "https://github.com/IsolatorD/sentinel#readme",
	"bugs": {
		"url": "https://github.com/IsolatorD/sentinel/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sentinel/core": "workspace:*",
		"@sentinel/shared": "workspace:*",
		"@types/node": "^26.6.4",
		"fastify": "^5.12.5",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
