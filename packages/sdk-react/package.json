{
	"name": "@argus-isolator/react",
	"version": "0.2.0",
	"description": "Sentinel SDK for React: ErrorBoundary, Profiler and root error hooks on top of @argus-isolator/browser.",
	"license": "MIT",
	"keywords": [
		"error-tracking",
		"react",
		"error-boundary"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IsolatorD/sentinel.git",
		"directory": "packages/sdk-react"
	},
	"homepage": "https://github.com/IsolatorD/sentinel#readme",
	"bugs": {
		"url": "https://github.com/IsolatorD/sentinel/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@argus-isolator/browser": "^0.2.0",
		"react": ">=18"
	},
	"devDependencies": {
		"@argus-isolator/browser": "workspace:*",
		"@sentinel/shared": "workspace:*",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
