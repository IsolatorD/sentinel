{
	"name": "@sentinel/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "~5.9.3"
	}
}
