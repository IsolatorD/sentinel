{
	"name": "@sentinel/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./source-maps": {
			"types": "./dist/source-maps.d.ts",
			"default": "./dist/source-maps.js"
		},
		"./scrub": {
			"types": "./dist/scrub.d.ts",
			"default": "./dist/scrub.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/source-maps.ts src/scrub.ts src/json-schemas.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts src/source-maps.ts src/scrub.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"export:schemas": "node scripts/export-json-schemas.mjs"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3"
	}
}
