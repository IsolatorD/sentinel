{
	"name": "@sentinel/browser",
	"version": "0.1.0",
	"description": "Sentinel SDK for browsers: captures errors and sends them to a Sentinel server.",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sentinel/core": "workspace:*",
		"@sentinel/shared": "workspace:*",
		"jsdom": "^30.1.2",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	}
}
