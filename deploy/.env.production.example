# Entorno de producción. Copiar a `.env.production` en la raíz del repo y rellenar.
# Los secretos se generan con: ./deploy/gen-env.sh   (no los escribas a mano ni los subas a git).

# Dominio público, sin https:// ni barra final. Sin dominio propio se puede usar uno de sslip.io
# derivado de la IP de la VM: 203-0-113-10.sslip.io  (para la IP 203.0.113.10).
DOMAIN=

# Contraseña de la base de datos y secreto de sesión (mínimo 16 caracteres).
# Si cambias BETTER_AUTH_SECRET las sesiones se cierran y el token de Jira guardado deja de poder leerse.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Correo (verificación de cuenta, invitaciones, alertas). Con Brevo:
#   SMTP_URL=smtp://USUARIO:CLAVE@smtp-relay.brevo.com:587
# El remitente debe estar verificado en el proveedor.
SMTP_URL=
SMTP_FROM="Sentinel <no-reply@tu-dominio.com>"
# Sin SMTP nadie puede verificar su correo: ponlo en false hasta tener correo configurado.
REQUIRE_EMAIL_VERIFICATION=true

# Instancia abierta al público (demo). Estos valores solo afectan a lo que se cree DESPUÉS de cambiarlos.
# Registro: false lo cierra (quien ya tiene cuenta sigue entrando; invitar a alguien nuevo exige abrirlo un momento).
SIGNUP_ENABLED=true
# Con qué límites nacen los proyectos nuevos; vacío = sin límite (retención vacía = 90 días).
# Cada proyecto puede cambiarlos después en Configuración → Datos y límites.
DEFAULT_MONTHLY_EVENT_QUOTA=10000
DEFAULT_MONTHLY_TRANSACTION_QUOTA=10000
DEFAULT_RETENTION_DAYS=30

# Que la propia instancia reporte sus errores a TU cuenta. Se rellena DESPUÉS de arrancar: entra, crea un
# proyecto para el backend y otro para la web (Configuración → Claves e instalación muestra su DSN) y pégalas:
# SELF_MONITOR_DSN=https://CLAVE@TU-DOMINIO/ID-DEL-PROYECTO-BACKEND       # API y worker
# SELF_MONITOR_WEB_DSN=https://CLAVE@TU-DOMINIO/ID-DEL-PROYECTO-WEB       # la web (si falta, usa la de arriba)

# Opcionales
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ENABLE_DOCS=true
# INGEST_RATE_LIMIT_PER_MINUTE=600
# LOG_LEVEL=info
# Etiqueta de las imágenes (útil al desplegar versiones concretas).
# TAG=local
